    - target: {fileID: 8282990593388475466, guid: 88cc947fc78953a459a04f4637dd9277, type: 3}
      propertyPath: content
      value: "Ng\xF4i l\xE0ng n\xE0y \u0111i\xEAn lo\u1EA1n h\u1EBFt r\u1ED3i. T\xF4i
        ph\u1EA3i ch\u1EA1y b\xE1n s\u1ED1ng b\xE1n ch\u1EBFt m\u1EDBi tho\xE1t \u0111\u01B0\u1EE3c
        kh\u1ECFi nh\u1EEFng th\u1EE9 kinh t\u1EDFm chui ra t\u1EEB nghi l\u1EC5
        c\u1EE7a b\u1ECDn h\u1ECD. T\xF4i \u0111\xE3 kh\xF3a c\u1EEDa d\u1EABn \u0111\u1EBFn
        n\u01A1i c\xFAng b\xE1i nh\u01B0ng m\u1ED9t v\xE0i th\u1EE9 v\u1EABn tho\xE1t
        ra \u0111\u01B0\u1EE3c. B\u1ECDn ch\xFAng \u0111ang \u1EDF ngo\xE0i nh\xE0
        c\u1EE7a t\xF4i. T\xF4i ph\u1EA3i r\u1EDDi kh\u1ECFi \u0111\xE2y tr\u01B0\u1EDBc
        khi qu\xE1 mu\u1ED9n, tr\u01B0\u1EDBc khi b\u1ECB nh\u1EEFng th\u1EE9 \u0111\xF3
        t\xF3m \u0111\u01B0\u1EE3c. Xin ch\xFAa h\xE3y th\u01B0\u01A1ng x\xF3t."
      objectReference: {fileID: 0}
    - target: {fileID: 8282990593388475466, guid: 88cc947fc78953a459a04f4637dd9277, type: 3}
