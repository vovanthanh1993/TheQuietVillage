    - target: {fileID: 8282990593388475466, guid: 88cc947fc78953a459a04f4637dd9277, type: 3}
      propertyPath: content
      value: "T\xF4i kh\xF4ng nh\u1EDB r\xF5 bao l\xE2u r\u1ED3i m\xECnh ch\u01B0a
        b\u01B0\u1EDBc ch\xE2n v\xE0o ng\xF4i l\xE0ng \u0111\xF3. Nh\u1EEFng \u0111\xF4i
        m\u1EAFt \u0111\u1ECF k\xE8m \xE2m thanh k\u1EF3 l\u1EA1 m\u1ED7i \u0111\xEAm
        l\xE0m t\xF4i r\u1EE3n c\u1EA3 ng\u01B0\u1EDDi. Nh\u01B0ng t\xF4i kh\xF4ng
        th\u1EC3 b\u1ECF qua nh\u1EEFng ti\u1EBFng than kh\xF3c, g\xE0o th\xE9t trong
        \u0111au \u0111\u1EDBn \u0111\xF3. T\xF4i s\u1EBD ph\u1EA3i xem chuy\u1EC7n
        g\xEC \u0111ang x\u1EA3y ra, gi\u1EA3i c\u1EE9u nh\u1EEFng con ng\u01B0\u1EDDi
        kh\u1ED1n kh\u1ED5 \u0111\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 8282990593388475466, guid: 88cc947fc78953a459a04f4637dd9277, type: 3}
      propertyPath: noteName
      value: Watchtower guard note 1
      objectReference: {fileID: 0}
